{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/ArcReactor/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/DataTable/**",
              "components/general/GlowText/**",
              "components/general/HudPanel/**",
              "components/general/Input/**",
              "components/general/ProgressBar/**",
              "components/general/SeverityBadge/**",
              "components/general/Spinner/**",
              "components/general/StatCard/**",
              "components/general/StatusBadge/**",
              "components/general/Tabs/**",
              "components/general/Waveform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcReactor'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<ArcReactor> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|rowKey|emptyMessage|className|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, rowKey, emptyMessage, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowText'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|as|children|className|key|ref|className|style|children)$/]",
        "message": "<GlowText> doesn't accept that prop. Declared props: color, as, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowText'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:cyan|orange|red|green|gold)$/]",
        "message": "<GlowText> color must be one of 'cyan' | 'orange' | 'red' | 'green' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<HudPanel> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|className|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|label|className|key|ref|className|style|children)$/]",
        "message": "<SeverityBadge> doesn't accept that prop. Declared props: severity, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|medium|low|info)$/]",
        "message": "<SeverityBadge> severity must be one of 'critical' | 'high' | 'medium' | 'low' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|className|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|color|className|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, icon, color, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|className|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:running|completed|failed|pending|cancelled)$/]",
        "message": "<StatusBadge> status must be one of 'running' | 'completed' | 'failed' | 'pending' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:bars|className|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: bars, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ArcReactor": {
        "replaces": []
