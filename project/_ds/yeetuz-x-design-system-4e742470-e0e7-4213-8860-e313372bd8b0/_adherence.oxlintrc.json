{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brand'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|dot|key|ref|className|style|children)$/]",
        "message": "<Brand> doesn't accept that prop. Declared props: href, label, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|arrow|magnetic|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, arrow, magnetic, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:right|up)$/]",
        "message": "<Button> arrow must be one of 'right' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapabilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<CapabilityCard> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomCursor'] > JSXAttribute > JSXIdentifier[name!=/^(?:enabled|key|ref|className|style|children)$/]",
        "message": "<CustomCursor> doesn't accept that prop. Declared props: enabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rule|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grain'] > JSXAttribute > JSXIdentifier[name!=/^(?:opacity|asset|key|ref|className|style|children)$/]",
        "message": "<Grain> doesn't accept that prop. Declared props: opacity, asset."
      },
      {
        "selector": "JSXOpeningElement[name.name='MailLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:email|key|ref|className|style|children)$/]",
        "message": "<MailLink> doesn't accept that prop. Declared props: email."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|cta|forceScrolled|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: links, cta, forceScrolled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Orb'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|spin|pulse|pulseAmount|pulseSpeed|nearColor|farColor|subdiv|parallax|key|ref|className|style|children)$/]",
        "message": "<Orb> doesn't accept that prop. Declared props: variant, size, spin, pulse, pulseAmount, pulseSpeed, nearColor, farColor, subdiv, parallax."
      },
      {
        "selector": "JSXOpeningElement[name.name='Orb'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|contained|indicator|mark)$/]",
        "message": "<Orb> variant must be one of 'hero' | 'contained' | 'indicator' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:delay|as|children|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: delay, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollCue'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<ScrollCue> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|index|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: label, index."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:copyright|links|signoff|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: copyright, links, signoff."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|name|desc|tags|meta|href|external|style|key|ref|className|style|children)$/]",
        "message": "<WorkRow> doesn't accept that prop. Declared props: num, name, desc, tags, meta, href, external, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
